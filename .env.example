# Copy to .env and adjust. Every setting is optional.

# --- Server ---
PORT=8080
HOST=0.0.0.0
# 1 "minute" = 1 second, so trips, escalations and share expiry can be shown live
DEMO_MODE=true
# Where the SQLite DB, encrypted evidence and keys are stored (default: server/data)
# DATA_DIR=./server/data
# Absolute public base URL used in generated links (set this when hosting or tunnelling)
# PUBLIC_URL=https://raksha.example.com
APP_TIMEZONE=Asia/Kolkata
MAX_EVIDENCE_MB=25

# --- Secrets (auto-generated into DATA_DIR when not set) ---
# AUTHORITY_API_KEY=
# MASTER_KEY=   # 64 hex chars (32 bytes). BACK THIS UP: it decrypts the evidence vault.

# --- Telegram alerts to trusted contacts (optional) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=

# --- Optional LLM for AI report structuring (an offline engine is used otherwise) ---
# Any OpenAI-compatible provider works. Free example (Google Gemini, key from https://aistudio.google.com/apikey):
#   OPENAI_API_KEY=your-gemini-key
#   OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   OPENAI_MODEL=gemini-3.8-flash
# Free example (Groq, key from https://console.groq.com/keys):
#   OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_MODEL=llama-3.3-70b-versatile
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Web Push ---
# VAPID_SUBJECT=mailto:you@example.com
